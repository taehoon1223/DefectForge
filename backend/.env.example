# Copy to backend/.env (optional). Real environment variables take precedence.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MIB=10
MAX_IMAGE_DIM=2048
MAX_EXPORT_COUNT=20
# Concurrent generation jobs and how long (s) a request waits for a free slot before 429.
MAX_CONCURRENT_JOBS=2
JOB_WAIT_SECONDS=15
# Optional directory for export ZIPs that exceed the in-memory spool (default: OS temp dir).
# EXPORT_TMP_DIR=
