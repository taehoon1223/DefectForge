{
  "seed": { "min": 0, "max": 4294967295, "default": 42 },
  "exportCount": { "min": 1, "max": 20, "default": 10 },
  "image": {
    "minDim": 32,
    "maxDim": 2048,
    "maxUploadBytes": 10485760,
    "acceptedMimeTypes": ["image/png", "image/jpeg", "image/webp"],
    "acceptedExtensions": [".png", ".jpg", ".jpeg", ".webp"]
  },
  "roiMaxPoints": 256,
  "area": {
    "regionMaxCount": 32,
    "referenceLineMinLengthPx": 4,
    "limits": { "edge_margin_px": [0, 50] },
    "defaults": { "edge_margin_px": 0 }
  },
  "scratchOptions": {
    "limits": {
      "angle_deg": [0, 180],
      "jitter_deg": [0, 45],
      "window_sigma_px": [2, 32],
      "min_texture_ratio": [0, 4]
    },
    "defaults": {
      "orientation": { "mode": "random", "angle_deg": 0, "jitter_deg": 5 },
      "shading": { "mode": "fixed", "window_sigma_px": 6, "min_texture_ratio": 1.0 }
    }
  },
  "defects": {
    "scratch": {
      "limits": {
        "count": [1, 20],
        "length_px": [8, 512],
        "width_px": [1, 20],
        "angle_deg": [0, 180],
        "contrast": [0.05, 1.0],
        "curvature": [0, 1]
      },
      "defaults": {
        "count": 2,
        "length_px": [40, 120],
        "width_px": [1, 3],
        "angle_deg": [0, 180],
        "contrast": [0.25, 0.6],
        "polarity": "dark",
        "curvature": 0.15
      }
    },
    "pinhole": {
      "limits": {
        "count": [1, 30],
        "radius_px": [1, 30],
        "irregularity": [0, 1],
        "contrast": [0.05, 1.0],
        "rim_strength": [0, 1]
      },
      "defaults": {
        "count": 3,
        "radius_px": [2, 6],
        "irregularity": 0.3,
        "contrast": [0.35, 0.85],
        "polarity": "bright",
        "rim_strength": 0.2
      }
    },
    "contamination": {
      "limits": {
        "count": [1, 30],
        "radius_px": [2, 80],
        "irregularity": [0, 1],
        "opacity": [0.1, 1.0],
        "blur_sigma": [0, 8]
      },
      "defaults": {
        "count": 2,
        "radius_px": [8, 24],
        "irregularity": 0.5,
        "opacity": [0.3, 0.7],
        "blur_sigma": 1.5,
        "polarity": "dark"
      }
    },
    "texture": {
      "limits": {
        "count": [1, 20],
        "radius_px": [4, 120],
        "opacity": [0.1, 1.0],
        "roughness": [0, 1]
      },
      "defaults": {
        "count": 2,
        "radius_px": [12, 32],
        "opacity": [0.5, 0.9],
        "roughness": 0.5,
        "source": "self"
      }
    },
    "patch": {
      "limits": {
        "count": [1, 20],
        "size_px": [8, 200],
        "scale": [0.5, 2.0]
      },
      "defaults": {
        "count": 2,
        "size_px": [20, 48],
        "scale": [0.8, 1.25],
        "blend": "source"
      }
    }
